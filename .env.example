# =============================================================================
# Maharlika Republic — Environment Variables Example
# =============================================================================
# Copy this file to .env.local and fill in real values.
# This file IS safe to commit to Git (no real secrets here).

# --- Database: Supabase + Drizzle ORM ---
# 
# You need TWO connection strings from Supabase Dashboard → Project Settings → Database
#
# DATABASE_URL: Session Pooler — used at RUNTIME by the Next.js app (IPv4 safe, port 5432)
DATABASE_URL=postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# DIRECT_URL: Direct connection — used ONLY by drizzle-kit for migrations (port 5432)
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[project-ref].supabase.co:5432/postgres

# --- MapLibre / MapTiler (for the showroom map) ---
# Get a free key at: https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key_here
