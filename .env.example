# =============================================================================
# Maharlika Republic — Environment Variables Example
# =============================================================================
# Copy this file to .env.local and fill in real values.
# This file IS safe to commit to Git (no real secrets here).

# --- Database (PostgreSQL via Drizzle ORM) ---
DATABASE_URL=postgresql://username:password@localhost:5432/maharlika_db

# --- MapLibre / MapTiler (for the showroom map) ---
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key_here
